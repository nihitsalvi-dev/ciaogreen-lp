# Copy this file to .env (local) AND add each value to Vercel → Settings → Environment Variables
# Never commit real values.

# --- Zoho CRM ---
# Datacenter: in (India) | com (US) | eu | au — Ciao Green is on 'in'
ZOHO_DC=in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Google Analytics 4 (Measurement Protocol) ---
# GA4 Admin → Data Streams → choose stream → Measurement Protocol API secrets → Create
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=

# --- Google Ads (used in GTM, not here directly) ---
# Add to GTM container as variables; not required server-side.

# --- Meta (Facebook + Instagram) ---
# Meta Events Manager → Settings → Conversions API → Generate access token
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional — only set during testing (Events Manager → Test Events)
META_TEST_EVENT_CODE=

# --- Fallback (if Zoho is down) ---
# Use a Google Apps Script web app or webhook.site to capture missed leads
FALLBACK_SHEET_WEBHOOK_URL=
